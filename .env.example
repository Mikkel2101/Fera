# Kopier til .env.local og fyll inn verdier (få dem fra Mikkel via sikker kanal).
# .env.local er gitignored — commit aldri ekte nøkler.

# ── Påkrevd for å kjøre siden lokalt ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hvilken merkevare localhost viser: travels | shop
NEXT_PUBLIC_DEFAULT_BRAND=travels

# Shop ligger i dvale (Travels-fokus) — la stå false så du ser det samme som
# ferapadel.com: / → /travels og /shop → /kolleksjon. Krever restart av dev-server.
NEXT_PUBLIC_SHOP_ENABLED=false

# Lokalt: la stå tom eller false, ellers ser du bare coming-soon-siden
COMING_SOON=false

# ── Kun for backend-arbeid (designer trenger IKKE disse) ───────────
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# OPS_EMAIL=
# Nyhetsbrev: hemmelighet for avmeldingslenker (minst 32 tegn, f.eks. `openssl rand -base64 48`).
# Må være lik i alle miljøer som sender eller tar imot avmelding.
# NEWSLETTER_UNSUBSCRIBE_SECRET=
# Valgfritt — standardverdiene står i lib/newsletter/config.ts:
# NEWSLETTER_FROM=Fera Padel <nyhetsbrev@ferabrand.com>
# NEWSLETTER_REPLY_TO=post@ferabrand.com
# NEWSLETTER_SENDER_INFO=Fera Padel · ferapadel.com · post@ferabrand.com
# NEWSLETTER_SITE_URL=https://ferapadel.com
# CRON_SECRET=
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_FERASHOP_URL=
# NEXT_PUBLIC_FERATRAVELS_URL=
