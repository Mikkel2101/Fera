# Kopier til .env.local og fyll inn verdier (få dem fra Mikkel via sikker kanal).
# .env.local er gitignored — commit aldri ekte nøkler.

# ── Påkrevd for å kjøre siden lokalt ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hvilken merkevare localhost viser: travels | shop
NEXT_PUBLIC_DEFAULT_BRAND=travels

# true = vis FeraShop (handlekurv, produktsider). Krever restart av dev-server.
NEXT_PUBLIC_SHOP_ENABLED=true

# Lokalt: la stå tom eller false, ellers ser du bare coming-soon-siden
COMING_SOON=false

# Plassholder så `npm run build` går gjennom (Stripe-klienten lages ved import).
# Betaling virker ikke lokalt med denne — det er meningen.
STRIPE_SECRET_KEY=sk_test_placeholder

# ── Kun for backend-arbeid (designer trenger IKKE disse) ───────────
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# OPS_EMAIL=
# CRON_SECRET=
